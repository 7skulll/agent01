RAG_APP_NAME=Enterprise RAG
# Fill in the provider's exact model ID, endpoint and API key locally.
RAG_LLM_PROVIDER=deepseek
RAG_LLM_MODEL=
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_TOKENS=256
# 连接本机 PostgreSQL；预先创建用户、业务库、测试库并安装 pgvector，启动时执行版本迁移。
RAG_DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:5432/langchain_rag
RAG_DATABASE_POOL_SIZE=10
# 先验证 exact；hnsw 要求 pgvector >=0.8 且明确的 1–2000 维。
RAG_VECTOR_SEARCH_MODE=exact
RAG_HNSW_EF_SEARCH=100
# 运行测试时显式设置，可使用专用测试库；每个测试/评估使用独立 schema。
RAG_TEST_DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:5432/langchain_rag_test
RAG_FILE_STORAGE_PATH=data/files
RAG_CHUNK_SIZE_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_CHUNK_MAX_PER_FILE=20000
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
# 0 表示不校验，首次调用后按实际返回推断。
RAG_EMBEDDING_DIM=0
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=3
RAG_EMBEDDING_NORMALIZE=true
# 离线编码器：cl100k_base / o200k_base / heuristic；后者仅显式兼容旧估算。
# BPE 不保证与 DeepSeek/Qwen 等远端模型完全一致，可分别指定。
RAG_EMBEDDING_TOKENIZER=cl100k_base
RAG_CHAT_TOKENIZER=cl100k_base
# 真实 Embedding 必填：从服务文档获取单条输入 token 上限，0 为未知并拒绝装配。
RAG_EMBEDDING_MAX_INPUT_TOKENS=0
# 可选批量总 token 限制，0 表示服务未声明；仍受条数限制。
RAG_EMBEDDING_MAX_BATCH_TOKENS=0
# 安全余量不能替代匹配的 tokenizer；用于 Embedding 上限及聊天总窗口。
RAG_TOKEN_SAFETY_RATIO=0.95
# 聊天模板额外余量，完整消息、工具 schema 和调用参数另行计数。
RAG_CHAT_TOKEN_OVERHEAD=256
RAG_PARSE_PDF_LAYOUT_MODE=true
RAG_PARSE_REMOVE_HEADER_FOOTER=true
RAG_PARSE_REMOVE_TOC=true
RAG_TABLE_CONTEXT_CHARS=0
RAG_AGENT_MAX_MODEL_CALLS=6
RAG_AGENT_MAX_TOOL_CALLS=8
RAG_AGENT_TIMEOUT_SECONDS=120
RAG_STREAM_HEARTBEAT_SECONDS=15
# 可选：设置后所有 /api/v1 请求需携带 Authorization: Bearer <token>（health 除外）。
# 留空关闭认证；前端使用 VITE_API_TOKEN 发送同一令牌。
RAG_API_TOKEN=
RAG_CORS_ALLOW_ORIGINS=*

RAG_CONTEXT_TOKENS=2048
RAG_INPUT_TOKENS=8192

# FastGPT 文本召回：路内多查询 RRF → 两路加权 RRF；查询扩展默认关闭
RAG_RETRIEVAL_DENSE_WEIGHT=0.5
RAG_RETRIEVAL_ANSWER_CANDIDATES=10
RAG_RETRIEVAL_MAX_PER_FILE=20
RAG_RETRIEVAL_NEIGHBOR_CHUNKS=0
RAG_QUERY_REWRITE=false
RAG_QUERY_EXPAND=false
RAG_QUERY_TIMEOUT_SECONDS=10
# 回答模型的同库历史窗口；完整会话历史仍持久化，切库时窗口重置。
RAG_HISTORY_TOKENS=1536
RAG_HISTORY_TURNS=3
# 知识库回答使用 JSON mode；兼容端点不支持时可关闭，服务端仍严格校验 JSON 协议。
RAG_ANSWER_JSON_MODE=true
# 开启 RETRIEVAL_NEIGHBOR_CHUNKS 时，邻居最多使用的资料预算比例。
RAG_NEIGHBOR_BUDGET_RATIO=0.2
# 启用后自动装配真实 HTTP Reranker；显式 create_app(reranker=...) 注入优先。
RAG_RERANK_ENABLED=false
RAG_RERANK_PROVIDER=siliconflow
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 查询+正文的预估总窗口；0 交给服务端。切换模型需按实际窗口与 tokenizer 重新配置。
RAG_RERANK_MAX_INPUT_TOKENS=8192
RAG_RERANK_TOKENIZER=cl100k_base
RAG_RERANK_WINDOW_OVERLAP_TOKENS=64
RAG_RERANK_BATCH_SIZE=64
RAG_RERANK_MAX_WINDOWS=1024
RAG_RETRIEVAL_RERANK_CANDIDATES=40
# 1 直接使用模型排序；0~1 之间与原排名做 RRF；0 且未设阈值则跳过重排。
RAG_RETRIEVAL_RERANK_WEIGHT=1
# 未校准时保持禁用；启用后只返回已重排且原始分数达到阈值的候选。
# 可选变量 RAG_RETRIEVAL_RERANK_MIN_SCORE 须使用业务样本校准后的数值，默认不设置。
RAG_RETRIEVAL_RERANK_TIMEOUT_SECONDS=10


# FastGPT 文本召回：混合模式向量 80 / 全文 60；纯模式 100；Jieba HMM 分词。
# 混合模式 min_score 不参与过滤；仅纯向量模式使用该阈值。
