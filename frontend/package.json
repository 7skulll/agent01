{
  "name": "langchain-rag-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript openapi.json -o src/api/generated.ts",
    "format": "prettier --write src tests *.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.90.0",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
